# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (Supabase) ---
# Use the SERVICE ROLE key (Project Settings > API). It stays on the server only.
# Leave both blank in development to store leads in data/leads.json instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin login (/admin) ---
ADMIN_USERNAME=admin
# Generate with:  npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=
# Long random string used to sign login sessions, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
